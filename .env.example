# ==============================================================================
# Solsnipe Bot - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with your own secure credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Server Environment
NODE_ENV="production"
PORT=3000
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
TRADING_MODE="simulation"

# Dashboard Authentication & Security
# Master password or PIN for dashboard access (required in production)
ADMIN_PASSWORD=""
# JWT/Session Secret (32+ random characters)
SESSION_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"
# Session timeout in minutes (0 = lock on browser tab close)
AUTO_LOCK_MINUTES=30

# Solana Network Configuration
# Recommended: Use private RPC provider (Helius, QuickNode, Triton, Shyft)
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# Optional secondary RPC fallback
SOLANA_RPC_BACKUP_URL=""

# Solana Live Trading Credentials (REQUIRED ONLY FOR LIVE MODE)
# Base58 private key from Phantom/Solflare or JSON byte array [1,2,3...]
# WARNING: Keep this strictly secret! Live mode will NEVER execute without this.
SOLANA_PRIVATE_KEY=""

# Live Trading Safety Gate (HARD SERVER-SIDE SWITCH)
# Live trades will NEVER execute unless this is explicitly set to true.
LIVE_TRADING_ENABLED="false"

# Risk Management Limits (Enforced Server-Side)
MAX_POSITION_SIZE_SOL=0.5
MAX_DAILY_LOSS_SOL=2.0
MAX_OPEN_POSITIONS=5
MAX_TOTAL_EXPOSURE_SOL=2.0
MAX_TRADES_PER_HOUR=20
MAX_SLIPPAGE_BPS=1500

# Telegram Signal Monitoring Configuration
# Obtain your API ID and Hash from https://my.telegram.org
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_PHONE=""
# Optional: GramJS session string for non-interactive server deployment
TELEGRAM_SESSION=""
TELEGRAM_SESSION_STRING=""
# Monitored Telegram channels (comma-separated usernames or channel IDs)
TELEGRAM_CHANNELS="pumpdotfunalert,solana_tracker,dexscreener"

# External On-Chain & Market Data Integrations
# Optional: GMGN API key for on-chain analysis
GMGN_API_KEY=""

# Optional: Jito Block Engine Configuration (For MEV-protected bundle execution)
JITO_BLOCK_ENGINE_URL="https://mainnet.block-engine.jito.wtf"
JITO_TIP_STREAM_URL=""
JITO_AUTH_KEYPAIR=""

# Optional: Gemini AI Contextual Token Analysis
# Injected automatically in AI Studio or provide your API key from Google AI Studio
GEMINI_API_KEY=""
